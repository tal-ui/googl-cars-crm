{
  "name": "VehicleCatalog",
  "type": "object",
  "description": "v2 VehicleCatalog — make/model spec catalog that Car links to via catalog_id (was unlinked, I-019). Fixed the truncated Hebrew descriptions from the legacy schema (I-018). body_style/aspiration/fuel_type use codes.",
  "properties": {
    "make": { "type": "string" },
    "model": { "type": "string" },
    "trim": { "type": "string" },
    "generation": { "type": "string" },
    "start_year": { "type": "number" },
    "end_year": { "type": "number" },
    "body_style": { "type": "string", "enum": ["sedan", "hatchback", "coupe", "convertible", "wagon", "suv", "pickup", "van", "other"] },
    "engine_displacement_cc": { "type": "number", "description": "נפח מנוע בסמ״ק" },
    "cylinders": { "type": "number" },
    "aspiration": { "type": "string", "enum": ["naturally_aspirated", "turbo", "supercharged", "twin_turbo", "electric", "hybrid"] },
    "fuel_type": { "type": "string", "enum": ["gasoline", "diesel", "hybrid", "plugin_hybrid", "electric"] },
    "avg_fuel_consumption": { "type": "number", "description": "צריכת דלק משולבת (קמ/ל)" },
    "maintenance_km": { "type": "number", "description": "מרווח טיפולים (ק״מ)" },
    "maintenance_months": { "type": "number", "description": "מרווח טיפולים (חודשים)" },
    "ev_battery_kwh": { "type": "number" },
    "power_hp": { "type": "number", "description": "הספק (כ״ס)" },
    "torque_nm": { "type": "number", "description": "מומנט (Nm)" },
    "transmission": { "type": "string" },
    "gears": { "type": "number" },
    "drivetrain": { "type": "string", "enum": ["FWD", "RWD", "AWD", "4WD"] },
    "doors": { "type": "number" },
    "seats": { "type": "number" },
    "wheelbase_mm": { "type": "number", "description": "בסיס גלגלים (מ״מ)" },
    "length_mm": { "type": "number", "description": "אורך (מ״מ)" },
    "width_mm": { "type": "number", "description": "רוחב (מ״מ)" },
    "height_mm": { "type": "number", "description": "גובה (מ״מ)" },
    "curb_weight_kg": { "type": "number", "description": "משקל עצמי (ק״ג)" },
    "market_region": { "type": "string" },
    "image_url": { "type": "string" },
    "specs": { "type": "object", "description": "שדה חופשי למפרטים נוספים" }
  },
  "required": ["make", "model"],
  "rls_intended": { "read": "staff", "create": "manager+", "update": "manager+", "delete": "admin" }
}
