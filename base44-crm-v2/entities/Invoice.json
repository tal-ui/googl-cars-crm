{
  "name": "Invoice",
  "type": "object",
  "description": "Accounting invoice. v2 replaces the invalid legacy RLS (auth.role() IN (...)) with verified Base44 RLS restricting read+write to finance roles. type/currency use codes.",
  "properties": {
    "invoice_number": { "type": "string" },
    "date": { "type": "string", "format": "date" },
    "month": { "type": "string", "description": "YYYY-MM" },
    "supplier_id": { "type": "string" },
    "customer_id": { "type": "string" },
    "related_vehicle_id": { "type": "string" },
    "type": { "type": "string", "enum": ["purchase", "sale", "expense", "income"], "description": "רכישה/מכירה/הוצאה/הכנסה (codes)" },
    "amount": { "type": "number", "minimum": 0 },
    "currency": { "type": "string", "enum": ["ILS", "USD", "EUR"], "default": "ILS" },
    "vat_amount": { "type": "number", "minimum": 0 },
    "total_amount": { "type": "number", "minimum": 0 },
    "description": { "type": "string" },
    "file_url": { "type": "string" },
    "file_name": { "type": "string" },
    "is_paid": { "type": "boolean", "default": false },
    "payment_date": { "type": "string", "format": "date" },
    "allocation_number": { "type": "string" },
    "notes": { "type": "string" }
  },
  "required": ["invoice_number", "date", "type", "total_amount"],
  "rls_intended": { "read": "manager+ (finance)", "create": "manager+", "update": "manager+", "delete": "admin" }
}
