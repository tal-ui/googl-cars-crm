{
  "name": "ContractArchive",
  "type": "object",
  "description": "Signed/generated contract record. v2 adds manager+/service RLS (was world-readable — contains customer ID numbers, prices). contract_type uses codes with Hebrew labels in the shared map.",
  "properties": {
    "contract_type": { "type": "string", "enum": ["import_agreement", "used_car_sale", "standard_sale", "service", "mou"], "description": "codes; Hebrew labels in shared map" },
    "customer_id": { "type": "string" },
    "customer_name": { "type": "string" },
    "customer_phone": { "type": "string" },
    "customer_id_number": { "type": "string" },
    "vehicle_id": { "type": "string" },
    "vehicle_make": { "type": "string" },
    "vehicle_model": { "type": "string" },
    "vehicle_year": { "type": "number" },
    "vehicle_license_plate": { "type": "string" },
    "vehicle_vin": { "type": "string" },
    "contract_date": { "type": "string", "format": "date" },
    "total_price": { "type": "number", "minimum": 0 },
    "file_url": { "type": "string" },
    "file_name": { "type": "string" },
    "signed": { "type": "boolean", "default": false },
    "signature_url": { "type": "string" },
    "signed_date": { "type": "string", "format": "date-time" },
    "created_by_name": { "type": "string" },
    "notes": { "type": "string" }
  },
  "required": ["contract_type", "customer_name", "file_url"],
  "rls_intended": {
    "read": "manager+; the public SignAgreement flow reads a single record by signed token (service), not a broad list",
    "create": "manager+ or service",
    "update": "manager+ or service (signature capture)",
    "delete": "admin"
  }
}
